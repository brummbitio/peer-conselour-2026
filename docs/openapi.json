          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-06T15:23:40Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-06T15:23:40Z"
          }
