          },
          "summary": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-06T09:30:12Z"
          },
          "updated_at": {
            "type": "string",
