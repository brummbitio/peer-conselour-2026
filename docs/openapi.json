          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-06T15:06:19Z"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 4576
          },
          "code": {
            "type": "string",
            "example": "004575"
          },
