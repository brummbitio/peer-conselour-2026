# =======================================================
# ENVIRONMENT CONFIGURATION - BACKEND GO
# Template file - copy to .env and configure values.
# =======================================================

# -------------------------------------------------------
# ✅ CONFIGURATION
# -------------------------------------------------------
PORT=8080
APP_ENV=development # development / production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=peer_counseling
DB_SSLMODE=disable # disable / require

# IAM UB Configuration (SSO)
IAM_CLIENT_ID=konseling
IAM_CLIENT_SECRET=your_iam_client_secret_here
IAM_REDIRECT_URI=http://localhost:8080/api/auth/callback

# OIDC endpoints for IAM UB
IAM_URL_AUTHORIZE=https://iam.ub.ac.id/auth/realms/ub/protocol/openid-connect/auth
IAM_URL_ACCESS_TOKEN=https://iam.ub.ac.id/auth/realms/ub/protocol/openid-connect/token
IAM_URL_USERINFO=https://iam.ub.ac.id/auth/realms/ub/protocol/openid-connect/userinfo

# JWT Configuration
JWT_SECRET=your_32_character_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=counseling-attachments
MINIO_USE_SSL=false

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
